<Application x:Class="PixelTransfer.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <Style TargetType="Window"><Setter Property="FontFamily" Value="Microsoft JhengHei UI, Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="#F5F7FB"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,6,10,6"/><Setter Property="MinHeight" Value="38"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,4,0,12"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,4,0,12"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,4,0,12"/></Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </Application.Resources>
</Application>
